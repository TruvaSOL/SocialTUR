# Copy this file to ".env" and fill in the values. Never commit ".env".
# Both values come from the Supabase dashboard: Project Settings -> API.

# Project URL (looks like https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Public "anon" key. Safe to ship to browsers; row level security protects the data.
VITE_SUPABASE_ANON_KEY=

# The secret "service_role" key must NEVER be placed in this file or in the repository.
# It lives only in the Supabase and hosting dashboards.
